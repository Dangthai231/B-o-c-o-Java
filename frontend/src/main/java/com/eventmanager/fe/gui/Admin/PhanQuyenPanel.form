<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eventmanager.fe.gui.Admin.PhanQuyenPanel">
  <grid id="a242" binding="mainPanel" layout-manager="GridLayoutManager" hgap="12" vgap="16" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false">
    <margin top="0" left="0" bottom="0" right="0" />
    <constraints>
      <xy x="20" y="20" width="1200" height="720" />
    </constraints>
    <properties>
      <background color="-657414" />
    </properties>
    <border type="none" />
    <children>
      <grid id="a240" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10" binding="pnlTieuDe">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <background color="-657414" />
        </properties>
        <border type="none" />
        <children>
          <component id="a238" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="24" style="1" />
              <foreground color="-16045232" />
              <text value="Phân quyền người dùng" />
            </properties>
          </component>
          <component id="a239" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="13" style="0" />
              <foreground color="-10322536" />
              <text value="Cấp quyền, thay đổi vai trò và tra cứu quyền của từng tài khoản" />
            </properties>
          </component>
        </children>
      </grid>
      <grid id="a237" layout-manager="BorderLayout" hgap="12" vgap="16" binding="pnlNoiDung">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <background color="-1" />
        </properties>
        <border type="empty">
          <size top="14" left="14" bottom="14" right="14" />
        </border>
        <children>
          <tabbedpane id="a236" binding="tabChucNang">
            <constraints border-constraint="Center" />
            <properties />
            <border type="none" />
            <children>
              <grid id="a224" layout-manager="BorderLayout" hgap="12" vgap="16">
                <constraints>
                  <tabbedpane title="Cấp / thay đổi quyền" />
                </constraints>
                <properties>
                  <background color="-1" />
                </properties>
                <border type="none" />
                <children>
                  <grid id="a222" layout-manager="BorderLayout" hgap="12" vgap="16" binding="pnlTimTaiKhoan">
                    <constraints border-constraint="West" />
                    <properties>
                      <background color="-1" />
                      <preferredSize>
                        <size width="260" height="300" />
                      </preferredSize>
                    </properties>
                    <border type="none" />
                    <children>
                      <grid id="nhom_txtTimTaiKhoan" binding="pnlTruongTxtTimTaiKhoan" layout-manager="BorderLayout" hgap="0" vgap="4">
                        <constraints border-constraint="North" />
                        <properties>
                          <opaque value="false" />
                        </properties>
                        <border type="none" />
                        <children>
                          <component id="nhan_txtTimTaiKhoan" binding="lblNhanTxtTimTaiKhoan" class="javax.swing.JLabel">
                            <constraints border-constraint="North" />
                            <properties>
                              <font name="Segoe UI" size="12" style="0" />
                              <foreground color="-10322536" />
                              <text value="Tìm tài khoản" />
                              <labelFor value="a219" />
                            </properties>
                          </component>
                          <component id="a219" binding="txtTimTaiKhoan" class="javax.swing.JTextField" custom-create="true">
                            <constraints border-constraint="Center" />
                            <properties>
                              <font name="Segoe UI" size="13" style="0" />
                              <toolTipText value="Tên hoặc email tài khoản" />
                              <preferredSize>
                                <size width="180" height="32" />
                              </preferredSize>
                              <minimumSize>
                                <size width="50" height="32" />
                              </minimumSize>
                            </properties>
                          </component>
                        </children>
                      </grid>
                      <scrollpane id="a221">
                        <constraints border-constraint="Center" />
                        <properties />
                        <border type="none" />
                        <children>
                          <component id="a220" binding="danhSachTaiKhoan" class="javax.swing.JList">
                            <constraints />
                            <properties>
                              <font name="Segoe UI" size="13" style="0" />
                            </properties>
                          </component>
                        </children>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="a223" binding="khungPhai" layout-manager="BorderLayout" hgap="12" vgap="16">
                    <constraints border-constraint="Center" />
                    <properties>
                      <background color="-1" />
                    </properties>
                    <border type="none" />
                    <children />
                  </grid>
                </children>
              </grid>
              <grid id="a233" layout-manager="BorderLayout" hgap="12" vgap="16">
                <constraints>
                  <tabbedpane title="Tra cứu quyền" />
                </constraints>
                <properties>
                  <background color="-1" />
                </properties>
                <border type="none" />
                <children>
                  <grid id="a230" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
                    <margin top="0" left="0" bottom="0" right="0" />
                    <constraints border-constraint="North" />
                    <properties>
                      <background color="-1" />
                    </properties>
                    <border type="none" />
                    <children>
                      <grid id="a228" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10" binding="pnlTraCuu">
                        <margin top="0" left="0" bottom="0" right="0" />
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
                        </constraints>
                        <properties>
                          <background color="-1" />
                        </properties>
                        <border type="none" />
                        <children>
                          <grid id="nhom_cboQuyen" binding="pnlTruongCboQuyen" layout-manager="BorderLayout" hgap="0" vgap="4">
                            <constraints>
                              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" />
                            </constraints>
                            <properties>
                              <opaque value="false" />
                            </properties>
                            <border type="none" />
                            <children>
                              <component id="nhan_cboQuyen" binding="lblNhanCboQuyen" class="javax.swing.JLabel">
                                <constraints border-constraint="North" />
                                <properties>
                                  <font name="Segoe UI" size="12" style="0" />
                                  <foreground color="-10322536" />
                                  <text value="Quyền cần tra cứu" />
                                  <labelFor value="a225" />
                                </properties>
                              </component>
                              <component id="a225" binding="cboQuyen" class="javax.swing.JComboBox">
                                <constraints border-constraint="Center" />
                                <properties>
                                  <font name="Segoe UI" size="13" style="0" />
                                  <model />
                                  <preferredSize>
                                    <size width="175" height="32" />
                                  </preferredSize>
                                  <minimumSize>
                                    <size width="110" height="32" />
                                  </minimumSize>
                                  <toolTipText value="Chọn quyền cần tra cứu" />
                                </properties>
                              </component>
                            </children>
                          </grid>
                          <grid id="nhom_txtTimTraCuu" binding="pnlTruongTxtTimTraCuu" layout-manager="BorderLayout" hgap="0" vgap="4">
                            <constraints>
                              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" />
                            </constraints>
                            <properties>
                              <opaque value="false" />
                            </properties>
                            <border type="none" />
                            <children>
                              <component id="nhan_txtTimTraCuu" binding="lblNhanTxtTimTraCuu" class="javax.swing.JLabel">
                                <constraints border-constraint="North" />
                                <properties>
                                  <font name="Segoe UI" size="12" style="0" />
                                  <foreground color="-10322536" />
                                  <text value="Lọc người có quyền" />
                                  <labelFor value="a226" />
                                </properties>
                              </component>
                              <component id="a226" binding="txtTimTraCuu" class="javax.swing.JTextField" custom-create="true">
                                <constraints border-constraint="Center" />
                                <properties>
                                  <font name="Segoe UI" size="13" style="0" />
                                  <toolTipText value="Tên hoặc email người dùng" />
                                  <preferredSize>
                                    <size width="180" height="32" />
                                  </preferredSize>
                                  <minimumSize>
                                    <size width="50" height="32" />
                                  </minimumSize>
                                </properties>
                              </component>
                            </children>
                          </grid>
                          <component id="a227" binding="btnTraCuu" class="javax.swing.JButton">
                            <constraints>
                              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" />
                            </constraints>
                            <properties>
                              <font name="Segoe UI" size="13" style="0" />
                              <background color="-15374912" />
                              <foreground color="-1" />
                              <focusPainted value="false" />
                              <preferredSize>
                                <size width="130" height="30" />
                              </preferredSize>
                              <text value="Tra cứu" />
                              <contentAreaFilled value="false" />
                              <opaque value="true" />
                              <borderPainted value="false" />
                            </properties>
                          </component>
                        </children>
                      </grid>
                      <component id="a229" binding="lblQuyenMacDinh" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
                        </constraints>
                        <properties>
                          <font name="Segoe UI" size="12" style="0" />
                          <foreground color="-14402733" />
                          <text value=" " />
                        </properties>
                      </component>
                    </children>
                  </grid>
                  <scrollpane id="a232">
                    <constraints border-constraint="Center" />
                    <properties />
                    <border type="none" />
                    <children>
                      <component id="a231" binding="bangTraCuu" class="com.eventmanager.fe.gui.Admin.common.BangDep" custom-create="true">
                        <constraints />
                        <properties />
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <scrollpane id="a235">
                <constraints>
                  <tabbedpane title="Danh mục quyền" />
                </constraints>
                <properties />
                <border type="none" />
                <children>
                  <component id="a234" binding="bangDanhMuc" class="com.eventmanager.fe.gui.Admin.common.BangDep" custom-create="true">
                    <constraints />
                    <properties />
                  </component>
                </children>
              </scrollpane>
            </children>
          </tabbedpane>
        </children>
      </grid>
    </children>
  </grid>
</form>

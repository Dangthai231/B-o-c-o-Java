<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eventmanager.fe.gui.HocSinh.DanhGiaPhanHoi">
  <grid id="1b00b" layout-manager="BorderLayout" hgap="0" vgap="18">

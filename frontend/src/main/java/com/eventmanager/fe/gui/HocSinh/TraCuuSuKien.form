<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eventmanager.fe.gui.HocSinh.TraCuuSuKien">
  <grid id="1a8f6" layout-manager="BorderLayout" hgap="0" vgap="18">
    <constraints>
      <xy x="20" y="20" width="1000" height="640"/>
    </constraints>
    <properties>
      <background color="-788999"/>
    </properties>
    <border type="empty">
      <size top="22" left="26" bottom="22" right="26"/>
    </border>
    <children>
      <grid id="1a8d1" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="1a887" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="24" style="1"/>
              <foreground color="-15456181"/>
              <text value="Tra cứu sự kiện"/>
            </properties>
          </component>
          <component id="1a8ac" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <foreground color="-8746850"/>
              <text value="Tìm sự kiện theo tên, khoảng ngày; xem chi tiết và đăng ký tham gia"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="1a862" layout-manager="BorderLayout" hgap="12" vgap="12">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line" title="Sự kiện | Bắt đầu | Số chỗ | Trạng thái | Của tôi | Thao tác (Chi tiết, Đăng ký)"/>
        <children>
          <grid id="1a7ce" layout-manager="GridLayoutManager" row-count="1" column-count="8" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints border-constraint="North"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="1a6a6" class="javax.swing.JTextField">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="240" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <toolTipText value="Tìm theo tên sự kiện..."/>
                </properties>
              </component>
              <component id="1a6cb" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="13" style="1"/>
                  <text value="Từ"/>
                </properties>
              </component>
              <component id="1a6f0" class="javax.swing.JTextField">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="130" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <toolTipText value="dd/MM/yyyy"/>
                </properties>
              </component>
              <component id="1a715" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="13" style="1"/>
                  <text value="đến"/>
                </properties>
              </component>
              <component id="1a73a" class="javax.swing.JTextField">
                <constraints>
                  <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="130" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <toolTipText value="dd/MM/yyyy"/>
                </properties>
              </component>
              <component id="1a75f" class="javax.swing.JComboBox">
                <constraints>
                  <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="170" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="1a784" class="javax.swing.JButton">
                <constraints>
                  <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-15374888"/>
                  <font size="13" style="1"/>
                  <foreground color="-1"/>
                  <text value="Tìm"/>
                </properties>
              </component>
              <component id="1a7a9" class="javax.swing.JButton">
                <constraints>
                  <grid row="0" column="7" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="↻"/>
                </properties>
              </component>
            </children>
          </grid>
          <scrollpane id="1a7f3">
            <constraints border-constraint="Center"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="1a818" class="javax.swing.JTable">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="1a83d" class="javax.swing.JLabel">
            <constraints border-constraint="South"/>
            <properties>
              <foreground color="-8746850"/>
              <text value="Hiển thị 15 / 15 sự kiện  •  Nhấp đúp vào một dòng để xem chi tiết"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
                          <font name="Segoe UI" size="12" style="0" />
                          <foreground color="-10322536" />
                          <text value="Tìm thông báo" />
                          <labelFor value="a92" />
                        </properties>
                      </component>
                      <component id="a92" binding="txtTimKiem" class="javax.swing.JTextField" custom-create="true">
                        <constraints border-constraint="Center" />
                        <properties>
                          <font name="Segoe UI" size="13" style="0" />
                          <toolTipText value="Tiêu đề, mã thông báo" />
                          <preferredSize>
                            <size width="180" height="32" />
                          </preferredSize>
                          <minimumSize>

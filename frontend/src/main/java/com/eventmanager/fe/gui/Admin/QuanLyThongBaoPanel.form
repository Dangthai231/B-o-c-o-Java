                      </preferredSize>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="a102" binding="btnTaoThongBao" class="javax.swing.JButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" anchor="4" fill="0" hsize-policy="0" vsize-policy="0" />
                </constraints>
                <properties>
                  <font name="Segoe UI" size="13" style="0" />
                  <background color="-15374912" />
                  <foreground color="-1" />
                  <focusPainted value="false" />
                  <preferredSize>

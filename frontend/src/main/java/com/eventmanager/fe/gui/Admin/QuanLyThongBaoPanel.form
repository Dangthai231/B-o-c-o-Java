          <grid id="a105" layout-manager="BorderLayout" hgap="12" vgap="16">
            <constraints border-constraint="Center" />
            <properties>
              <background color="-1" />
            </properties>
            <border type="none" />
            <children>
              <grid id="a94" layout-manager="BorderLayout" hgap="12" vgap="16" binding="pnlBoLoc">
                <constraints border-constraint="North" />
                <properties>
                  <background color="-1" />
                </properties>
                <border type="none" />
                <children>
                  <grid id="nhom_txtTimKiem" binding="pnlTruongTxtTimKiem" layout-manager="BorderLayout" hgap="0" vgap="4">
                    <constraints border-constraint="West" />
                    <properties>
                      <opaque value="false" />
                    </properties>
                    <border type="none" />
                    <children>
                      <component id="nhan_txtTimKiem" binding="lblNhanTxtTimKiem" class="javax.swing.JLabel">
                        <constraints border-constraint="North" />

                    </properties>
                  </component>
                  <component id="loc_4" class="javax.swing.JToggleButton" binding="btnLocDaGo">
                    <constraints />
                    <properties>
                      <font name="Segoe UI" size="12" style="0" />
                      <text value="Đã gỡ" />
                      <toolTipText value="Lọc: đã gỡ" />
                      <contentAreaFilled value="false" />
                      <opaque value="true" />
                      <borderPainted value="false" />
                      <focusPainted value="false" />
                      <background color="-657414" />

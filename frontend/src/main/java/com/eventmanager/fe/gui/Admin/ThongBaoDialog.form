<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eventmanager.fe.gui.Admin.ThongBaoDialog">
  <grid id="a353" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="0" left="0" bottom="0" right="0" />
    <constraints>
      <xy x="20" y="20" width="1200" height="720" />
    </constraints>
    <properties>
      <background color="-1" />
    </properties>
    <border type="none" />
    <children>
      <grid id="a341" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
        </constraints>
        <properties>
          <background color="-1" />
        </properties>
        <border type="none" />
        <children>
          <component id="a340" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="12" style="1" />
              <foreground color="-14402733" />
              <text value="Tiêu đề *" />
            </properties>
          </component>
          <component id="a339" binding="txtTieuDe" class="javax.swing.JTextField" custom-create="true">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="13" style="0" />
              <toolTipText value="Nhập tiêu đề thông báo" />
              <preferredSize>
                <size width="180" height="32" />
              </preferredSize>
              <minimumSize>
                <size width="50" height="32" />
              </minimumSize>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="a344" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
        </constraints>
        <properties>
          <background color="-1" />
        </properties>
        <border type="none" />
        <children>
          <component id="a343" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="12" style="1" />
              <foreground color="-14402733" />
              <text value="Gửi tới *" />
            </properties>
          </component>
          <component id="a342" binding="cboDoiTuongNhan" class="javax.swing.JComboBox">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="13" style="0" />
              <model>
                <item value="Tất cả người tham gia" />
                <item value="Sinh viên" />
                <item value="Ban tổ chức" />
                <item value="Cán bộ sự kiện" />
                <item value="Đại biểu" />
                <item value="Khách mời" />
              </model>
              <preferredSize>
                <size width="175" height="32" />
              </preferredSize>
              <minimumSize>
                <size width="110" height="32" />
              </minimumSize>
              <toolTipText value="Chọn nhóm người nhận thông báo" />
            </properties>
          </component>
        </children>
      </grid>
      <grid id="a348" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
        </constraints>
        <properties>
          <background color="-1" />
        </properties>
        <border type="none" />
        <children>
          <component id="a347" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="12" style="1" />
              <foreground color="-14402733" />
              <text value="Nội dung *" />
            </properties>
          </component>
          <scrollpane id="a346">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
            </constraints>
            <properties />
            <border type="none" />
            <children>
              <component id="a345" binding="txtNoiDung" class="javax.swing.JTextArea">
                <constraints />
                <properties>
                  <font name="Segoe UI" size="13" style="0" />
                  <rows value="7" />
                  <lineWrap value="true" />
                  <wrapStyleWord value="true" />
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <component id="a349" binding="loi" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
        </constraints>
        <properties>
          <font name="Segoe UI" size="12" style="0" />
          <foreground color="-2345659" />
          <text value=" " />
        </properties>
      </component>
      <grid id="a352" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" />
        </constraints>
        <properties>
          <background color="-1" />
        </properties>
        <border type="none" />
        <children>
          <component id="a350" binding="huy" class="javax.swing.JButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="13" style="0" />
              <background color="-1" />
              <foreground color="-14402733" />
              <focusPainted value="false" />
              <preferredSize>
                <size width="130" height="30" />
              </preferredSize>
              <text value="Hủy" />
            </properties>
          </component>
          <component id="a351" binding="luu" class="javax.swing.JButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" />
            </constraints>
            <properties>
              <font name="Segoe UI" size="13" style="0" />
              <background color="-15374912" />
              <foreground color="-1" />
              <focusPainted value="false" />
              <preferredSize>
                <size width="130" height="30" />
              </preferredSize>
              <text value="Lưu thông báo" />
              <contentAreaFilled value="false" />
              <opaque value="true" />
              <borderPainted value="false" />
            </properties>
          </component>
        </children>
      </grid>
    </children>
